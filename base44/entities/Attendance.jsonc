{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "number",
      "default": 1
    },
    "amount": {
      "type": "number"
    },
    "paid": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "worker_id",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}