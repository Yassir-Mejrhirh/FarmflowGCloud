{
  "name": "InputInvoice",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Invoice date"
    },
    "invoice_number": {
      "type": "string",
      "description": "Supplier invoice number"
    },
    "supplier_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string",
      "description": "Input purchased"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity purchased"
    },
    "unit": {
      "type": "string",
      "description": "Unit of the purchased quantity, e.g. L, KG, Flacon"
    },
    "unit_price": {
      "type": "number",
      "description": "Price per unit"
    },
    "amount": {
      "type": "number",
      "description": "Total invoice amount"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}