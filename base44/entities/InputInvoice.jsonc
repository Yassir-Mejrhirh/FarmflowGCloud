{
  "name": "InputInvoice",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Invoice date"
    },
    "invoice_number": {
      "type": "string",
      "description": "Supplier invoice number"
    },
    "supplier_id": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "description": "Inputs purchased on this invoice",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "description": "Unit of the quantity, e.g. L, KG, Flacon"
          },
          "unit_price": {
            "type": "number"
          }
        }
      }
    },
    "amount": {
      "type": "number",
      "description": "Total invoice amount"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}