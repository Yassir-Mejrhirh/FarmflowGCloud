{
  "name": "Task",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Nature of the task: planting, irrigation, fertilising, spraying, harvest, maintenance, transport, other, or a custom nature name",
      "default": "other"
    },
    "subtask": {
      "type": "string",
      "description": "Short label of the sub-task"
    },
    "description": {
      "type": "string",
      "description": "Details of what has to be done"
    },
    "block_id": {
      "type": "string"
    },
    "crop_id": {
      "type": "string"
    },
    "assignee_id": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done"
      ],
      "default": "todo"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "machine_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether a machine must be selected to validate a daily report for this task"
    },
    "estimated_cost": {
      "type": "number"
    },
    "actual_cost": {
      "type": "number"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}