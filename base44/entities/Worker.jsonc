{
  "name": "Worker",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "description": "Presence priority: 1 all year, 2 frequent depending on the season, 3 rarely present",
      "enum": [
        "1",
        "2",
        "3"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "default": "1"
    },
    "definition": {
      "type": "string",
      "description": "Whether the worker is paid by name (nominative) or by a salary band",
      "enum": [
        "nominative",
        "salary_band"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "worker_function": {
      "type": "string",
      "description": "Job function such as Tractoriste or Irrigueur, from the WorkerFunction list"
    },
    "farm": {
      "type": "string",
      "description": "Farm the worker is permanently assigned to; empty means the worker is mobile"
    },
    "team": {
      "type": "string",
      "description": "Team the worker belongs to, when applicable"
    },
    "registration_number": {
      "type": "string",
      "description": "Registration / social security number"
    },
    "declared": {
      "type": "boolean",
      "default": false,
      "description": "Whether the worker is declared"
    },
    "transport_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether transport details apply to this worker"
    },
    "transporter_name": {
      "type": "string"
    },
    "transport_rate_type": {
      "type": "string",
      "enum": [
        "fixed",
        "per_person"
      ],
      "default": "fixed"
    },
    "transport_rate": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
    "daily_rate": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Hire date, when known"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}