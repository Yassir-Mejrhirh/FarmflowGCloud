{
  "name": "Worker",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "field_worker",
        "operator",
        "supervisor",
        "seasonal"
      ],
      "default": "field_worker"
    },
    "worker_function": {
      "type": "string",
      "description": "Job function such as Tractoriste or Irrigueur, from the WorkerFunction list"
    },
    "farm": {
      "type": "string",
      "description": "Farm the worker is permanently assigned to; empty means the worker is mobile"
    },
    "team": {
      "type": "string",
      "description": "Team the worker belongs to"
    },
    "registration_number": {
      "type": "string",
      "description": "Registration / social security number"
    },
    "declared": {
      "type": "boolean",
      "default": false,
      "description": "Whether the worker is declared"
    },
    "transporter_name": {
      "type": "string"
    },
    "transport_rate_type": {
      "type": "string",
      "enum": [
        "fixed",
        "per_person"
      ],
      "default": "fixed"
    },
    "transport_rate": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
    "daily_rate": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}