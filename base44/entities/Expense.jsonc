{
  "name": "Expense",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "labour",
        "inputs",
        "machinery",
        "transport",
        "utilities",
        "other"
      ],
      "default": "other"
    },
    "amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "block_id": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "amount"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}