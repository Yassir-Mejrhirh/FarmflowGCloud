{
  "name": "MaintenanceLog",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "machine_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "kind": {
      "type": "string",
      "enum": [
        "service",
        "repair",
        "inspection"
      ],
      "default": "service"
    },
    "description": {
      "type": "string"
    },
    "cost": {
      "type": "number"
    },
    "hours_reading": {
      "type": "number"
    }
  },
  "required": [
    "machine_id",
    "date"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}