{
  "name": "InputItem",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Category name, e.g. Insecticide, Herbicide, Engrais"
    },
    "formulation": {
      "type": "string",
      "description": "Formulation such as Liquide, Poudre, Granule"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measure, e.g. L, KG, Sac"
    },
    "supplier_ids": {
      "type": "array",
      "description": "Suppliers of this input",
      "items": {
        "type": "string"
      }
    },
    "min_stock_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether a minimum stock alert is active for this input"
    },
    "min_stock": {
      "type": "number",
      "description": "Alert threshold quantity"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}