{
  "name": "Harvest",
  "type": "object",
  "properties": {
    "block_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "quantity_kg": {
      "type": "number",
      "description": "Total yield weight collected, in kg"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "block_id",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}