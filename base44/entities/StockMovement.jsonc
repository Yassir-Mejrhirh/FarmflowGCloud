{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "item_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ],
      "default": "in",
      "enumColors": [
        "green",
        "red"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "cost": {
      "type": "number"
    },
    "storage_id": {
      "type": "string",
      "description": "Storage the movement applies to"
    },
    "block_id": {
      "type": "string"
    },
    "machine_id": {
      "type": "string",
      "description": "Machine that consumed the input, when the movement comes from machine fuel or maintenance"
    },
    "report_id": {
      "type": "string",
      "description": "Daily report that generated this movement"
    },
    "count_id": {
      "type": "string",
      "description": "Inventory count that generated this adjustment, if any"
    },
    "maintenance_id": {
      "type": "string",
      "description": "Maintenance operation that withdrew the parts and lubricants, if any"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "date"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}