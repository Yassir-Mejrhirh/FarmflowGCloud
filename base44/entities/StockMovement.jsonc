{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ],
      "default": "in"
    },
    "quantity": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "cost": {
      "type": "number"
    },
    "block_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}