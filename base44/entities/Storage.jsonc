{
  "name": "Storage",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "warehouse",
        "cold_room",
        "silo",
        "shed"
      ],
      "default": "warehouse"
    },
    "farms": {
      "type": "array",
      "description": "Names of the farms the storage supplies; empty means it serves every farm",
      "items": {
        "type": "string"
      }
    },
    "farm": {
      "type": "string",
      "description": "First associated farm, kept for older records and quick display"
    },
    "location": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "capacity_note": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}