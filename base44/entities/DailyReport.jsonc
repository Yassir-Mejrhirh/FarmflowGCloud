{
  "name": "DailyReport",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "group_id": {
      "type": "string",
      "description": "Entry that wrote this report together with the other parcels of the same day"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "block_id": {
      "type": "string",
      "description": "Parcel the operations were carried out on"
    },
    "task_id": {
      "type": "string",
      "description": "Task from the catalogue that was carried out"
    },
    "operation": {
      "type": "string",
      "enum": [
        "planting",
        "irrigation",
        "fertilising",
        "spraying",
        "harvest",
        "maintenance",
        "transport",
        "other"
      ],
      "default": "other"
    },
    "description": {
      "type": "string"
    },
    "pump_station_id": {
      "type": "string",
      "description": "Pumping station used when the operation is irrigation or fertigation"
    },
    "pump_hours": {
      "type": "number",
      "description": "Hours the pumping station ran for this operation"
    },
    "water_m3": {
      "type": "number",
      "description": "Water pumped for this operation, in cubic metres"
    },
    "labour": {
      "type": "array",
      "description": "Workers used, the days worked, and the daily rate applied at the date of the report",
      "items": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string"
          },
          "days": {
            "type": "number"
          },
          "daily_rate": {
            "type": "number",
            "description": "Daily rate kept with the line so the cost of the report never changes when a rate is revised"
          }
        }
      }
    },
    "machinery": {
      "type": "array",
      "description": "Machines used, their hours, and the fuel and lubricant drawn from stock for each machine",
      "items": {
        "type": "object",
        "properties": {
          "machine_id": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "fuel_item_id": {
            "type": "string",
            "description": "Fuel input taken from stock for this machine"
          },
          "fuel_quantity": {
            "type": "number",
            "description": "Quantity of fuel consumed by this machine"
          },
          "lubricant_item_id": {
            "type": "string",
            "description": "Lubricant input taken from stock for this machine"
          },
          "lubricant_quantity": {
            "type": "number",
            "description": "Quantity of lubricant consumed by this machine"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "description": "Other inputs consumed and their quantities",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "block_id"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}