{
  "name": "FarmBlock",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "name": {
      "type": "string",
      "description": "Block name"
    },
    "code": {
      "type": "string",
      "description": "Short reference code"
    },
    "farm": {
      "type": "string",
      "description": "Farm the block belongs to"
    },
    "locality": {
      "type": "string",
      "description": "Locality or village of the block"
    },
    "area_ha": {
      "type": "number",
      "description": "Area in hectares, calculated from boundary"
    },
    "boundary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      }
    },
    "crop_id": {
      "type": "string"
    },
    "variety_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string",
      "description": "Season the block is currently cultivated in"
    },
    "planting_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of the crop cycle in the block"
    },
    "crop_end_date": {
      "type": "string",
      "format": "date",
      "description": "End date of the crop cycle in the block"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "preparing",
        "harvest",
        "fallow"
      ],
      "default": "active"
    },
    "soil_type": {
      "type": "string"
    },
    "sub_blocks": {
      "type": "array",
      "description": "Sub-divisions of the block, each with its own area and variety",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "area_ha": {
            "type": "number"
          },
          "variety_id": {
            "type": "string"
          }
        }
      }
    },
    "irrigation_zones": {
      "type": "array",
      "description": "Subdivisions of the block for irrigation",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "area_ha": {
            "type": "number"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}