{
  "name": "Machine",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "tractor",
        "harvester",
        "sprayer",
        "truck",
        "implement",
        "other"
      ],
      "default": "tractor"
    },
    "model": {
      "type": "string"
    },
    "plate": {
      "type": "string"
    },
    "hourly_rate": {
      "type": "number"
    },
    "hours": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "maintenance",
        "retired"
      ],
      "default": "operational"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}