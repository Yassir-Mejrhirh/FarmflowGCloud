{
  "name": "Machine",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Company this record belongs to"
    },
    "name": {
      "type": "string"
    },
    "reference": {
      "type": "string",
      "description": "Machine reference or identifier"
    },
    "type": {
      "type": "string",
      "description": "Machine type: tractor, harvester, sprayer, truck, implement, other, or a custom machine type name",
      "default": "tractor"
    },
    "farm": {
      "type": "string",
      "description": "Farm the machine belongs to; for a pumping station, only the stations of the farm of the report are proposed. Detected from the name the first time, then kept here"
    },
    "year": {
      "type": "number",
      "description": "Manufacturing year"
    },
    "plate": {
      "type": "string"
    },
    "photo_uri": {
      "type": "string",
      "description": "Private storage URI of the machine photo"
    },
    "spare_parts": {
      "type": "array",
      "description": "Spare part references for this machine",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "Part kind: oil_filter, fuel_filter, air_filter, hydraulic_filter, belt, battery, spark_plug, other"
          },
          "brand": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        }
      }
    },
    "hourly_rate": {
      "type": "number"
    },
    "hours": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "maintenance",
        "retired"
      ],
      "default": "operational"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}